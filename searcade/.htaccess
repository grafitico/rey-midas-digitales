# SEARCADE (searcade.reymidascr.com) — Apache en Banahosting
Options -Indexes
DirectoryIndex index.html

RewriteEngine On
# Siempre HTTPS (la cámara del probador de la fase 2 lo necesita)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Enlaces copiados con un punto o coma al final ("admin.html.") → sin él
RewriteRule ^(.*?)[.,;:]+$ /$1 [L,R=301]
# Dirección corta del panel
RewriteRule ^admin/?$ /admin.html [L,R=302]
# Página para compartir un diseño (vista previa en WhatsApp/Facebook) y sitemap
RewriteRule ^d/([A-Za-z0-9_-]{1,40})/?$ d.php?id=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|json|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|mp3|m4a|ogg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# No servir documentación interna
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
