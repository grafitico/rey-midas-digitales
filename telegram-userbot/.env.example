# Credenciales de Telegram — sacalas de https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Session string — generada por `node login.js`. Tratala como una contraseña.
TG_SESSION=

# Canal fuente. Username sin @ o ID numérico (ej -1001234567890).
TG_CHANNEL=swichtaccount

# GitHub PAT con permiso Contents: Read and write sobre el repo.
GITHUB_TOKEN=
GITHUB_REPO=grafitico/rey-midas-digitales
GITHUB_BRANCH=main
