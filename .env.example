# ==============================================================================
# BANA HOSTING - Carátulas en Alta Calidad
# ==============================================================================
BANA_HOST=ftp.banahosting.com
BANA_USER=tu_usuario_bana
BANA_PASSWORD=tu_contraseña_bana
BANA_REMOTE_PATH=/public_html/covers
BANA_PUBLIC_URL=https://tu-dominio.bana.hosting/covers

# ==============================================================================
# APIs Públicas
# ==============================================================================
RAWG_API_KEY=tu_rawg_api_key
IGDB_CLIENT_ID=tu_igdb_client_id
IGDB_ACCESS_TOKEN=tu_igdb_access_token

# ==============================================================================
# Supabase (Backend principal)
# ==============================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ==============================================================================
# GitHub (Sincronización de bundles)
# ==============================================================================
GITHUB_TOKEN=tu_github_pat
GITHUB_REPO=grafitico/rey-midas-digitales
GITHUB_BRANCH=main

# ==============================================================================
# Telegram (Bot de bundles)
# ==============================================================================
TELEGRAM_BOT_TOKEN=tu_bot_token
TELEGRAM_WEBHOOK_SECRET=tu_webhook_secret_aleatorio
TELEGRAM_CHANNEL_ID=-1001234567890
PUBLIC_BASE_URL=https://tu-sitio.com

# ==============================================================================
# Vercel (Frontend)
# ==============================================================================
VERCEL_PROJECT_ID=tu_project_id
VERCEL_ORG_ID=tu_org_id
VERCEL_TOKEN=tu_vercel_token
